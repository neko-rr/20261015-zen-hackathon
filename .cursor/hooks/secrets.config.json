{
  "promptPatterns": [
    {
      "id": "openai_api_key",
      "pattern": "sk-(?:proj-)?[A-Za-z0-9_-]{20,}",
      "label": "OpenAI API キー"
    },
    {
      "id": "aws_access_key",
      "pattern": "AKIA[0-9A-Z]{16}",
      "label": "AWS Access Key ID"
    },
    {
      "id": "github_token",
      "pattern": "gh[oprsu]_[A-Za-z0-9_]{20,}",
      "label": "GitHub トークン"
    },
    {
      "id": "private_key_block",
      "pattern": "-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----",
      "label": "秘密鍵（PEM）"
    },
    {
      "id": "env_secret_assignment",
      "pattern": "(?:AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|OPENAI_API_KEY|ANTHROPIC_API_KEY|BEDROCK_[A-Z_]*KEY)\\s*=\\s*['\"]?[^\\s'\"]{8,}",
      "label": "環境変数への秘匿値の直書き"
    }
  ],
  "promptAllowSubstrings": [
    ".env.example",
    "your-key-here",
    "YOUR_API_KEY",
    "{TODO}",
    "<API_KEY>"
  ],
  "shellBlockPatterns": [
    {
      "id": "git_add_env",
      "pattern": "git\\s+add(?:\\s+[^\\s&|;]+)*\\s+[^\\s&|;]*\\.env",
      "label": ".env を git add"
    },
    {
      "id": "git_add_pem",
      "pattern": "git\\s+add(?:\\s+[^\\s&|;]+)*\\s+[^\\s&|;]*\\.pem",
      "label": ".pem を git add"
    },
    {
      "id": "git_force_push",
      "pattern": "git\\s+push[^\\n;|&]*(--force|-f\\b)",
      "label": "force push"
    },
    {
      "id": "git_hard_reset",
      "pattern": "git\\s+reset\\s+--hard",
      "label": "hard reset"
    },
    {
      "id": "git_clean_fd",
      "pattern": "git\\s+clean\\s+[^\\n;|&]*(-fd|-df|-f\\s+-d|-d\\s+-f)",
      "label": "git clean -fd（未追跡ファイル削除）"
    }
  ]
}
