#!/bin/sh
# ステージ済みの差分から、.env 実ファイルと鍵らしい行を拒否する。
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

status=0
while IFS= read -r path; do
  [ -z "$path" ] && continue
  base=$(basename "$path")
  case "$base" in
    .env|.env.local|.env.production|*.pem|*-key.json|credentials.json)
      echo "pre-commit: 秘密ファイルはコミットできません: $path" >&2
      status=1
      ;;
  esac
  case "$path" in
    .env.*)
      case "$base" in
        .env.example) ;;
        *)
          echo "pre-commit: 秘密ファイルはコミットできません: $path" >&2
          status=1
          ;;
      esac
      ;;
  esac
done <<EOF
$staged
EOF

if [ "$status" -ne 0 ]; then
  exit 1
fi

if git diff --cached -U0 | grep -E -q 'AIza[0-9A-Za-z_-]{20,}|BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY|service_role|sk-[A-Za-z0-9]{20,}'; then
  echo "pre-commit: 鍵らしい行がステージされています。値は表示しません。" >&2
  exit 1
fi
