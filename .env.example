# キー名のみ。実値は .env（Git に入れない）
# 区分は docs/deploy/env-contract.md

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# 画面を http://localhost:3000 で開く場合も可（web が API ホストを自動で揃える）
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
GOOGLE_CLOUD_PROJECT=illustration-support
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True
# 出典検索と呼び方。公式のモデル ID。実値は .env と Cloud Run だけ
GEMINI_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GCS_BUCKET=illustration-support-photos
TYPESAFE_API_KEY=
YOUCAM_API_KEY=
# セッション Cookie 署名。ローカルも必ず長いランダム文字列を入れる
SESSION_SIGNING_SECRET=
# 本番 HTTPS は true。ローカル http は false のまま
SESSION_COOKIE_SECURE=false
# 手元資料の意味検索。true のとき人ごとの Gemini API File Search。キーは GEMINI_API_KEY か GOOGLE_API_KEY。RAG Engine は使わない
RAG_ENABLED=false
# 以下は提出後・需要確認後（ハッカソンでは使わない）
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=
# ハギングフェイス
HF_TOKEN=